# ==================================================
# A. 基础平台（后端进程本身）
# ==================================================
MPFM_APP_NAME=mpfm-backend
MPFM_SPRING_PROFILE=dev
MPFM_SERVER_PORT=8080

# ==================================================
# A1. HTTPS/TLS（Spring Boot 内嵌证书）
# ==================================================
# 是否启用 HTTPS（true/false）
MPFM_TLS_ENABLED=false
# keystore 路径（Windows 示例：file:./backend/certs/keystore.p12）
MPFM_TLS_KEYSTORE_PATH=
MPFM_TLS_KEYSTORE_TYPE=PKCS12
MPFM_TLS_KEYSTORE_PASSWORD=
MPFM_TLS_KEY_ALIAS=
MPFM_TLS_ENABLED_PROTOCOLS=TLSv1.3,TLSv1.2

# ==================================================
# B. 数据库 PostgreSQL（DB）
# ==================================================
MPFM_DB_NAME=mpfm
MPFM_DB_URL=jdbc:postgresql://localhost:5432/mpfm
MPFM_DB_USERNAME=mpfm
MPFM_DB_PASSWORD=mpfm_dev_password
MPFM_DB_POOL_MIN_IDLE=5
MPFM_DB_POOL_MAX_SIZE=20
MPFM_DB_AUTO_COMMIT=false
MPFM_DB_TX_ISOLATION=TRANSACTION_READ_COMMITTED
MPFM_DB_POOL_NAME=mpfm-hikari
MPFM_DB_VALIDATION_TIMEOUT_MS=3000

# ==================================================
# C. Redis（缓存/限流）
# ==================================================
MPFM_REDIS_HOST=localhost
MPFM_REDIS_PORT=6379
MPFM_REDIS_PASSWORD=

# ==================================================
# D. 认证与会话（后端安全）
# ==================================================
MPFM_JWT_ISSUER=mpfm-dev
MPFM_JWT_SIGNING_KEY=replace_with_32_plus_chars_secret
MPFM_ACCESS_TOKEN_EXPIRE_SECONDS=900
MPFM_REFRESH_TOKEN_EXPIRE_SECONDS=1209600
MPFM_ROOT_USERNAME=root
MPFM_ROOT_PASSWORD=Root@123456

# ==================================================
# E. 头像（后端文件存储与签名）
# ==================================================
MPFM_LOCAL_BASE_PATH=./backend/data/local
MPFM_AVATAR_BASE_PATH=./backend/data/avatars
MPFM_AVATAR_SIGNING_KEY=change_this_avatar_signing_key_with_32_chars_min
MPFM_AVATAR_SIGNED_URL_EXPIRE_SECONDS=300

# ==================================================
# F. 上传/限流（后端运行参数）
# ==================================================
MPFM_MAX_FILE_SIZE=100MB
MPFM_MAX_REQUEST_SIZE=100MB
MPFM_MAX_SWALLOW_SIZE=20MB

# ==================================================
# G. SFTP HostKey 校验策略
# ==================================================
# 可选值：insecure | pinned | known_hosts
# insecure：不校验主机指纹（开发调试用，默认）
# pinned：校验单一指纹（需配置 MPFM_SFTP_PINNED_FINGERPRINT）
# known_hosts：校验指纹白名单文件（需配置 MPFM_SFTP_KNOWN_HOSTS_PATH）
MPFM_SFTP_HOSTKEY_MODE=insecure
# 示例：SHA256:LhVgIyTAJNLV1BTDIcN7JjOvs0PtGjjPYiMs2JADTXw
MPFM_SFTP_PINNED_FINGERPRINT=
# 文件内容为“每行一个指纹”，允许 # 注释行
MPFM_SFTP_KNOWN_HOSTS_PATH=

# ==================================================
# H. 后端高级参数（一般不用改）
# ==================================================
MPFM_DB_DRIVER=org.postgresql.Driver
MPFM_JPA_DDL_AUTO=validate
MPFM_JPA_OPEN_IN_VIEW=false
MPFM_JPA_FORMAT_SQL=true
MPFM_FLYWAY_ENABLED=true
MPFM_FLYWAY_LOCATIONS=classpath:db/migration
MPFM_MANAGEMENT_EXPOSE=health,info,prometheus
MPFM_AUDIT_ENABLED=true
MPFM_WEBDAV_ENABLED=true
MPFM_WEBDAV_ROOT_PATH=/dav
MPFM_SPRINGDOC_API_DOCS_PATH=/api-docs
MPFM_SPRINGDOC_API_DOCS_ENABLED=true
MPFM_SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
MPFM_SPRINGDOC_SWAGGER_UI_ENABLED=true
MPFM_SCALAR_PATH=/scalar
MPFM_SCALAR_ENABLED=true
MPFM_LOG_LEVEL_ROOT=INFO
MPFM_LOG_LEVEL_SECURITY=INFO

# ==================================================
# I. 测试（后端测试脚本/CI）
# ==================================================
MPFM_TEST_DB_URL=jdbc:postgresql://localhost:5432/mpfm_test
MPFM_TEST_DB_NAME=mpfm_test
MPFM_TEST_DB_USERNAME=mpfm
MPFM_TEST_DB_PASSWORD=mpfm_dev_password
MPFM_TEST_DB_POOL_MIN_IDLE=1
MPFM_TEST_DB_POOL_MAX_SIZE=5
MPFM_TEST_DB_AUTO_COMMIT=false
MPFM_TEST_DB_TX_ISOLATION=TRANSACTION_READ_COMMITTED
MPFM_TEST_DB_POOL_NAME=mpfm-test-hikari

# ==================================================
# J. Docker / Compose 部署专属说明
# ==================================================
# 仅 `docker-compose-deploy.yml` 会按容器网络和挂载路径读取下面这组值。
# 重点关注：
# - MPFM_DB_NAME / MPFM_DB_URL / MPFM_DB_USERNAME / MPFM_DB_PASSWORD
# - MPFM_REDIS_HOST / MPFM_REDIS_PORT / MPFM_REDIS_PASSWORD
# - MPFM_JWT_ISSUER / MPFM_JWT_SIGNING_KEY
# - MPFM_ROOT_USERNAME / MPFM_ROOT_PASSWORD
# - MPFM_LOCAL_BASE_PATH / MPFM_AVATAR_BASE_PATH / MPFM_AVATAR_SIGNING_KEY
# - VITE_BACKEND_ORIGIN
# 容器内通常要用 `postgres`、`redis` 和 `/data/...`，不要直接沿用本机 `localhost` 或 `./data/...`。
