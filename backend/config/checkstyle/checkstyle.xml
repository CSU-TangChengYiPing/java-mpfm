<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="severity" value="warning"/>

    <module name="SuppressionFilter">
        <property name="file" value="config/checkstyle/checkstyle-suppressions.xml"/>
    </module>

    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="NeedBraces"/>
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround"/>
        <module name="EmptyBlock"/>
        <module name="CommentsIndentation"/>
        <module name="RegexpSinglelineJava">
            <property name="format" value="^\s*//\s*(if|for|while|switch|try|catch|return|throw|[A-Za-z_$][\w$\[\]]*\s+[A-Za-z_$][\w$]*\s*=|[A-Za-z_$][\w$]*\s*\(.*\)\s*;)\b"/>
            <property name="message" value="检测到疑似被注释掉的代码（僵尸代码）。请直接删除，Git 会保留历史，不要遗留在源码中！"/>
        </module>

        <!-- 对外严格：核心类型/方法/字段要求 Javadoc -->
        <module name="MissingJavadocType">
            <property name="severity" value="warning"/>
            <property name="scope" value="public"/>
        </module>
    </module>
</module>


