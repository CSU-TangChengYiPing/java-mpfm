# ==================================================
# A. 前端基础联调（后端地址）
# ==================================================
# 后端真实地址（用于 WebDAV 外链展示）
VITE_BACKEND_ORIGIN=https://localhost:8443
# Vite /api 代理目标地址（开发环境）
VITE_DEV_BACKEND_TARGET=https://localhost:8443

# ==================================================
# B. 前端开发 HTTPS（本地证书）
# ==================================================
# 是否启用前端 HTTPS（https://localhost:5173）
VITE_DEV_HTTPS=false

# 方案A：使用 PFX/P12（推荐 Windows）
VITE_DEV_HTTPS_PFX_FILE=./certs/frontend-dev.p12
VITE_DEV_HTTPS_PFX_PASSPHRASE=请替换为你的 keystore 口令

# 方案B：使用 PEM 证书对（仅当不使用 PFX 时启用）
# VITE_DEV_HTTPS_KEY_FILE=./certs/frontend-dev-key.pem
# VITE_DEV_HTTPS_CERT_FILE=./certs/frontend-dev-cert.pem

# ==================================================
# C. 上传通道（传输模式）
# ==================================================
# 上传传输模式：xhr（默认）或 tus（可选）
VITE_UPLOAD_TRANSPORT=xhr

# ==================================================
# D. 上传并发与预算
# ==================================================
VITE_UPLOAD_CHUNK_CONCURRENCY=3
VITE_UPLOAD_FILE_CONCURRENCY=2
VITE_UPLOAD_TOTAL_CHUNK_BUDGET=4

# ==================================================
# E. 重试与恢复策略
# ==================================================
VITE_UPLOAD_CHUNK_RETRY_MAX=4
VITE_UPLOAD_CHUNK_RETRY_BASE_MS=300
VITE_UPLOAD_RECOVERY_SUCCESS_THRESHOLD=20

# ==================================================
# F. 刷新后任务回收窗口（毫秒）
# ==================================================
VITE_UPLOAD_STALE_RUNNING_MS=30000
