{
  "name": "mpfm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "overrides": {
      "js-cookie": "^3.0.7"
    }
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "a11y": "playwright test e2e/a11y.smoke.spec.ts --config playwright.a11y.config.ts",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "lint:comments": "eslint src e2e --ext ts,tsx --max-warnings 0 && node scripts/comment-long-function-check.mjs",
    "lint:typed": "eslint . --ext ts,tsx --max-warnings 0 --config eslint.typed.config.js",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:check:strict": "node scripts/i18n-check.mjs --strict",
    "audit:deps": "node scripts/audit-high.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "perf:bundle": "node scripts/perf-budget.mjs",
    "perf:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "gate:fast": "pnpm i18n:check && pnpm lint && pnpm lint:comments && pnpm typecheck && pnpm test",
    "gate:full": "pnpm gate:fast && pnpm build",
    "gate:release": "pnpm gate:full && pnpm a11y && pnpm perf:bundle && pnpm audit:deps",
    "ci:check": "pnpm gate:fast"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@heroui/breadcrumbs": "2.2.7",
    "@heroui/button": "2.2.10",
    "@heroui/card": "2.2.10",
    "@heroui/checkbox": "2.3.9",
    "@heroui/chip": "2.2.7",
    "@heroui/input": "2.4.10",
    "@heroui/modal": "2.2.8",
    "@heroui/navbar": "2.2.9",
    "@heroui/pagination": "2.2.9",
    "@heroui/popover": "2.3.32",
    "@heroui/progress": "2.2.7",
    "@heroui/select": "^2.4.33",
    "@heroui/slider": "^2.4.29",
    "@heroui/spinner": "2.2.7",
    "@heroui/switch": "^2.2.27",
    "@heroui/system": "2.4.28",
    "@heroui/table": "2.2.9",
    "@heroui/tabs": "^2.2.29",
    "@heroui/theme": "2.4.26",
    "@heroui/tooltip": "^2.2.29",
    "@types/path-browserify": "^1.0.3",
    "@uidotdev/usehooks": "^2.4.1",
    "@uiw/react-codemirror": "^4.25.10",
    "ahooks": "^3.9.7",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "i18next": "^26.0.9",
    "lucide-react": "^1.14.0",
    "motion": "^12.40.0",
    "path-browserify": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "react-easy-crop": "^5.5.7",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.6",
    "react-icons": "^5.6.0",
    "react-photo-view": "^1.2.7",
    "react-router-dom": "^6.30.3",
    "react-virtuoso": "^4.18.7",
    "recharts": "2.15.4",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
